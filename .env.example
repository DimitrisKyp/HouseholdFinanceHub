# Every setting the app reads. Copy to .env.local for development (`npm run db:init` writes the
# database URLs for you) and set the same names in Coolify for production. No values belong here.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection, e.g. postgres://user:password@host:5432/household_hub
DATABASE_URL=
# Optional. A separate address for the live-updates connection (LISTEN), needed when DATABASE_URL
# goes through a pooler in "transaction" mode (e.g. Supabase port 6543): use a direct or "session"
# mode address (Supabase port 5432). Leave empty on a normal server.
# LIVE_DATABASE_URL=
# Optional. Database connections per app process (default 10). Use 3 on serverless hosting (Vercel).
# DATABASE_POOL_MAX=
# Long random secret for sign-in sessions. A new one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# The app's public address (https:// in production). Links in emails and share previews use it.
BETTER_AUTH_URL=http://localhost:3000

# ── Email (needed in production: confirmations, password resets, invitations) ─
# e.g. smtps://user:password@smtp.example.com:465. Without it, emails are printed to the console in
# development and not sent at all in production.
SMTP_URL=
EMAIL_FROM="Household Hub <no-reply@example.com>"

# ── Markets & news panel (optional; these are the defaults) ──────────────────
# RATES_API_URL=https://api.frankfurter.dev/v1
# NEWS_FEED_URL=https://feeds.bbci.co.uk/news/business/rss.xml
# NEWS_SOURCE_NAME=BBC News
# MARKET_CACHE_SECONDS=900

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Browser events accepted per minute from one address.
# TELEMETRY_MAX_PER_MINUTE=120

# ── Development and tests only ────────────────────────────────────────────────
# Separate database for the browser tests (`npm run db:init-test` writes it). Must contain "test".
TEST_DATABASE_URL=
# Local PostgreSQL for scripts/local-db.mjs, if not found automatically.
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
# LOCAL_DB_DIR=
# Browser for the tests: msedge locally by default; CI uses Playwright's Chromium.
# E2E_BROWSER_CHANNEL=chrome
